{
  "name": "movicloud",
  "version": "1.0.5",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "build:fnOS": "NUXT_PUBLIC_PLATFORM=fnOS nuxt build",
    "build:Synology": "NUXT_PUBLIC_PLATFORM=Synology nuxt build",
    "build:Docker": "NUXT_PUBLIC_PLATFORM=Docker nuxt build",
    "build:Demo": "NUXT_PUBLIC_PLATFORM=Demo nuxt build",
    "build:macOS": "NUXT_PUBLIC_PLATFORM=macOS nuxt build",
    "build:all": "npm run build:fnOS && npm run build:Synology && npm run build:Docker && npm run build:Demo && npm run build:macOS",
    "dev": "nuxt dev",
    "dev:fnOS": "NUXT_PUBLIC_PLATFORM=fnOS nuxt dev",
    "dev:Synology": "NUXT_PUBLIC_PLATFORM=Synology nuxt dev",
    "dev:Docker": "NUXT_PUBLIC_PLATFORM=Docker nuxt dev",
    "dev:Demo": "NUXT_PUBLIC_PLATFORM=Demo nuxt dev",
    "dev:macOS": "NUXT_PUBLIC_PLATFORM=macOS nuxt dev",
    "generate": "nuxt generate",
    "preview": "cd .output && NITRO_PORT=15078 node server/index.mjs",
    "start": "cd .output && NITRO_PORT=15078 node server/index.mjs",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@pinia/nuxt": "^0.11.2",
    "@tailwindcss/postcss": "^4.1.11",
    "@tailwindcss/vite": "^4.0.15",
    "@tanstack/vue-query": "^5.85.5",
    "@tanstack/vue-query-devtools": "^5.85.5",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "bcrypt": "^6.0.0",
    "chart.js": "^4.4.8",
    "hpagent": "^1.2.0",
    "jsonwebtoken": "^9.0.2",
    "nuxt": "^3.16.1",
    "pinia": "^3.0.3",
    "primeicons": "^7.0.0",
    "primevue": "^4.3.2",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.0.15",
    "tailwindcss-primeui": "^0.6.1",
    "typescript": "^5.6.3",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
